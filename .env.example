DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
# Trust the configured number of reverse-proxy hops when deriving client IPs for API rate limits.
TRUST_PROXY_HOPS=1
# Keep AI provider and CAPTCHA secrets only on the API server.
GROQ_API_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=tmgbusinessconsulting.com,www.tmgbusinessconsulting.com
AI_SESSION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret
# Local CMS media storage for development; switch to s3 when configuring AWS.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=storage/cms
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-private-project-files-bucket
# Prefer the API runtime's IAM role. Only set access keys when role-based credentials are unavailable.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for S3-compatible development storage.
AWS_S3_ENDPOINT=
AWS_S3_SCAN_TAG_KEY=GuardDutyMalwareScanStatus
# Admin-configurable project upload limit defaults to 100 MB (admin UI allows 1-2048 MB).
MAX_PROJECT_UPLOAD_SIZE_MB=100
# Microsoft Graph app-only integration. Configure secrets only in the API environment.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER_EMAIL=
M365_DRIVE_ID=
# Power BI workspace ID; uses the Microsoft app registration above.
POWERBI_WORKSPACE_ID=
