DATABASE_URL="postgresql://...your-neon-url"
JWT_SECRET="your-super-secret-jwt-key-change-this-local-preferred"
JWT_EXPIRES_IN="7d"
# PayPal subscriptions use the browser SDK and server-side subscription verification.
# Store actual credentials and webhook IDs in the deployment secret manager.
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret"
PAYPAL_WEBHOOK_ID="your_paypal_sandbox_webhook_id"
# Required for CMS media uploads and CV document storage in production.
# Project file storage (DEFAULT: LOCAL DISK, private folder, no external keys)
# Files saved under private-storage/project-files and served only via authenticated backend download (no public links).
STORAGE_MODE="local"

# Optional fallback (OFF by default): Cloudflare R2 only when ALL R2 vars below are set.
# Leave empty to use local disk.
# R2_ACCOUNT_ID=""
# R2_BUCKET=""
# R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_REGION="auto"

# Malware scanning (local ClamAV only; no external scan service)
# Option A (recommended): local clamd daemon
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
# Option B: local command (use {file} placeholder)
# CLAMAV_SCAN_COMMAND="clamscan --no-summary {file}"
# Set true to require scan in all environments (recommended for staging/prod)
REQUIRE_MALWARE_SCAN="false"
MAX_PROJECT_UPLOAD_SIZE_MB="100"
FRONTEND_URL="http://localhost:3002"
STORAGE_MODE="local"

# Security / networking
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://www.tmgbusinessconsulting.com,https://tmgbusinessconsulting.com"
TRUST_PROXY_HOPS="1"

# Bot protection / AI
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES="localhost,tmgbusinessconsulting.com,www.tmgbusinessconsulting.com"
GROQ_API_KEY=

# Monitoring
SENTRY_DSN=

# Email (SMTP) - required for verification, password reset, and upload notifications
# Resend SMTP (recommended): SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_USER=resend SMTP_PASS=re_...
ADMIN_NOTIFICATION_EMAIL="info@tmgbusinessconsulting.com"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TMG Business Consulting <info@tmgbusinessconsulting.com>"


