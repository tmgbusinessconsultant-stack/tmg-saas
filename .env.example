DATABASE_URL="postgresql://...your-neon-url"
JWT_SECRET="your-super-secret-jwt-key-change-this-local-preferred"
JWT_EXPIRES_IN="7d"
# PayPal subscriptions use the browser SDK and server-side subscription verification.
# Store actual credentials and webhook IDs in the deployment secret manager.
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret"
PAYPAL_WEBHOOK_ID="your_paypal_sandbox_webhook_id"
# Required for CMS media uploads and CV document storage in production.
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-private-bucket-name"
# Optional S3-compatible endpoint for non-production environments.
# AWS_S3_ENDPOINT="http://localhost:9000"
# GuardDuty Malware Protection for S3 result tag key.
AWS_S3_SCAN_TAG_KEY="GuardDutyMalwareScanStatus"
# Prefer an API runtime IAM role. Use static keys only when workload identity is unavailable.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
MAX_PROJECT_UPLOAD_SIZE_MB="100"
FRONTEND_URL="http://localhost:3002"
STORAGE_MODE="local"

# Security / networking
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://www.tmgbusinessconsulting.com,https://tmgbusinessconsulting.com"
TRUST_PROXY_HOPS="1"

# Bot protection / AI
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES="localhost,tmgbusinessconsulting.com,www.tmgbusinessconsulting.com"
GROQ_API_KEY=

# Monitoring
SENTRY_DSN=

# Email (SMTP) - required for verification and password reset in production
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TMG Business Consulting <no-reply@tmgbusinessconsulting.com>"
