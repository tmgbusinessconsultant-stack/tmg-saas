datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum PlanStatus {
  FREE
  ACTIVE
  CANCELED
  PAST_DUE
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String?
  passwordHash String
  role         Role         @default(USER)
  isActive     Boolean      @default(true)
  tokenVersion Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  cvDocuments  CvDocument[]
  userPlan     UserPlan?

  @@map("User")
}

model UserPlan {
  id                   String     @id @default(uuid())
  userId               String     @unique
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String     // starter, pro, growth
  status               PlanStatus @default(FREE)
  billingCycle         String     @default("monthly") // monthly, annual
  autoRenew            Boolean    @default(true)
  paypalSubscriptionId String?    @unique
  paypalOrderId        String?
  trialEndsAt          DateTime?
  usageLimit           Int        @default(10)
  usageCount           Int        @default(0)
  allowedTools         String[]   @default(["cv-builder", "business-assistant"])
  endDate              DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@map("UserPlan")
}

model CvDocument {
  id           String   @id @default(uuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  content      String   @db.Text
  storageKey   String
  downloadMode String   @default("FREE") // FREE, PAID
  price        Float    @default(0.0)
  currency     String   @default("QAR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("CvDocument")
}
