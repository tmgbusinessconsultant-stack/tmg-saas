import { Injectable, Logger, NotFoundException } from '@nestjs/common';
import { PrismaService } from '../prisma/prisma.service';
import type { AuthenticatedUser } from '../auth/auth.service';

@Injectable()
export class ProjectsService {
  private readonly logger = new Logger(ProjectsService.name);
  constructor(private readonly prisma: PrismaService) {}

  async list(user: AuthenticatedUser) {
    try {
      this.logger.log(`Listing projects for ${user.id}`);
      const projects = await (this.prisma as any).project.findMany({
        orderBy: { createdAt: 'desc' },
        take: 200,
      });
      return projects.map((p: any) => ({
        ...p,
        owner: p.ownerId ? { id: p.ownerId } : null,
        assignee: p.assigneeId ? { id: p.assigneeId } : null,
        files: [],
        messages: [],
        activities: [],
      }));
    } catch (e) {
      this.logger.error('list() failed', e);
      return [];
    }
  }

  async listStaff() {
    try {
      return await (this.prisma as any).user.findMany({
        where: { role: { in: ['STAFF', 'ADMIN', 'CONSULTANT'] } },
        select: { id: true, name: true, email: true, role: true },
        take: 100,
      });
    } catch (e) {
      this.logger.error('listStaff() failed', e);
      return [];
    }
  }

  async create(user: AuthenticatedUser, body: any) {
    return (this.prisma as any).project.create({
      data: {
        ownerId: user.id,
        title: body.title || 'New Project',
        description: body.description || '',
        serviceType: body.serviceType || 'GENERAL',
        status: 'NEW',
      },
    });
  }

  async updateStatus(user: AuthenticatedUser, projectId: string, status: string) {
    if (!status) throw new NotFoundException('Status required');
    return (this.prisma as any).project.update({ where: { id: projectId }, data: { status } });
  }

  async assign(user: AuthenticatedUser, projectId: string, assigneeId: string | null) {
    return (this.prisma as any).project.update({ where: { id: projectId }, data: { assigneeId: assigneeId || null } });
  }

  async sendMessage(user: AuthenticatedUser, projectId: string, body: string) {
    if (!body?.trim()) throw new NotFoundException('Message body required');
    return (this.prisma as any).projectMessage.create({ data: { projectId, authorId: user.id, body } });
  }

  async initiateUpload(user: AuthenticatedUser, projectId: string, body: any) {
    return (this.prisma as any).projectFile.create({
      data: {
        projectId,
        name: body.name || 'file',
        originalName: body.name || 'file',
        contentType: body.contentType || 'application/octet-stream',
        size: body.size || 0,
        kind: body.kind || 'GENERAL',
        status: 'PENDING',
        uploadedById: user.id,
      },
    });
  }

  async presignPart(user: AuthenticatedUser, projectId: string, fileId: string, partNumber: number) {
    return { fileId, partNumber, url: '', message: 'DB-only mode' };
  }

  async completeUpload(user: AuthenticatedUser, projectId: string, fileId: string, parts: any) {
    return (this.prisma as any).projectFile.update({ where: { id: fileId }, data: { status: 'COMPLETED' } });
  }

  async abortUpload(user: AuthenticatedUser, projectId: string, fileId: string) {
    return (this.prisma as any).projectFile.update({ where: { id: fileId }, data: { status: 'ABORTED' } });
  }

  async scanStatus(user: AuthenticatedUser, projectId: string, fileId: string) {
    const file = await (this.prisma as any).projectFile.findUnique({ where: { id: fileId } });
    if (!file) throw new NotFoundException('File not found');
    return { status: file.status, scanResult: 'CLEAN' };
  }

  async download(user: AuthenticatedUser, projectId: string, fileId: string) {
    const file = await (this.prisma as any).projectFile.findUnique({ where: { id: fileId } });
    if (!file) throw new NotFoundException('File not found');
    return { fileId, name: file.name, downloadUrl: '' };
  }
}
