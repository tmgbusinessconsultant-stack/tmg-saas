{
  "name": "tmg-saas-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npx prisma generate && npx nest build",
    "vercel-build": "npx prisma generate && npx nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "tsx --test test/auth/rbac.spec.ts test/common/site-access.spec.ts test/common/content-scan.spec.ts test/projects/project-file-security.spec.ts test/payments/payment-security.spec.ts test/paypal/paypal-config.spec.ts test/paypal/paypal-webhook-rate-limit.spec.ts",
    "test:e2e": "npm run build && tsx --test test/e2e/health.e2e.spec.ts test/e2e/auth-project.e2e.spec.ts",
    "test:e2e:auth": "npm run build && tsx --test --test-name-pattern=authentication test/e2e/auth-project.e2e.spec.ts",
    "test:e2e:project": "npm run build && tsx --test --test-name-pattern=project test/e2e/auth-project.e2e.spec.ts",
    "test:e2e:cms": "npm run build && tsx --test test/e2e/cms.e2e.spec.ts",
    "prisma:migrate:deploy": "npx prisma migrate deploy"
  },
  "engines": {
    "node": ">=20.9.0"
  },
